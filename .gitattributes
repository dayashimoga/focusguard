# Auto detect text files and normalize line endings
* text=auto eol=lf

*.dart text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.webp binary
