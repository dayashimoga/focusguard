#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

echo "==> [clean] Cleaning FocusGuard build and test artifacts..."

rm -rf "${WORKSPACE_DIR}/build"
rm -rf "${WORKSPACE_DIR}/coverage"
rm -rf "${WORKSPACE_DIR}/.dart_tool"
rm -rf "${WORKSPACE_DIR}/acceptance.json"
rm -rf "${WORKSPACE_DIR}/acceptance.html"

echo "==> [clean] Project disposable resources cleaned."
