#!/usr/bin/env bash
set -euo pipefail

CONTAINER_NAME="focusguard-dev"
IMAGE_NAME="ghcr.io/cirruslabs/flutter:3.24.3"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

echo "==> [acceptance] Running FocusGuard Production Certification Pipeline..."

ARGS="${*:-}"

CMD="dart run acceptance/acceptance_runner.dart ${ARGS}"

if [ -f "/workspace/pubspec.yaml" ]; then
  eval "$CMD"
else
  if podman ps --filter "name=^${CONTAINER_NAME}$" --format "{{.Names}}" | grep -q "^${CONTAINER_NAME}$"; then
    podman exec -w /workspace "${CONTAINER_NAME}" bash -c "$CMD"
  else
    podman run --rm \
      -v "${WORKSPACE_DIR}:/workspace:Z" \
      -w /workspace \
      "${IMAGE_NAME}" \
      bash -c "$CMD"
  fi
fi

echo "==> [acceptance] Certification pipeline completed."
